---
import { siteConfig } from "../site.config";
import { sitePath } from "../lib/urls";
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href={sitePath()} aria-label={`${siteConfig.name} 首页`}>
      {siteConfig.name}
    </a>

    <nav class="site-nav" aria-label="主要导航">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题">
        明暗
      </button>
    </nav>
  </div>
</header>
