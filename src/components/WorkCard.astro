---
import type { WorkEntry } from "../lib/content";
import { workStatusLabel, workTypeLabel } from "../lib/content";
import { workPath } from "../lib/urls";

interface Props {
  work: WorkEntry;
  chapterCount: number;
}

const { work, chapterCount } = Astro.props;
const { data } = work;
---

<article class="work-card">
  <a href={workPath(data.slug)}>
    <span class="work-card__title">{data.title}</span>
    <span class="work-card__details">
      {workTypeLabel(data.type)} · {workStatusLabel(data.status)} · {chapterCount} 章
    </span>
    <span class="work-card__arrow" aria-hidden="true">›</span>
  </a>
</article>
