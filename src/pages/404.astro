---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../lib/urls";
---

<BaseLayout title="页面没有找到">
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1>这一页还没有写进故事。</h1>
    <p>链接可能已失效，或者章节还没有公开。</p>
    <a class="button button--primary" href={sitePath()}>返回书架</a>
  </section>
</BaseLayout>

