---
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedChapters, getPublishedSections, getPublishedWorks } from "../lib/content";
import { chapterPath, sectionPath } from "../lib/urls";

const works = await getPublishedWorks();
const workCards = await Promise.all(
  works.map(async (work) => {
    const chapters = await getPublishedChapters(work.data.slug, work.data.type);
    return {
      work,
      chapterCount: chapters.length,
      readingPaths: [
        ...chapters.map((chapter) =>
          chapterPath(work.data.slug, chapter.data.chapterId),
        ),
        ...(
          work.data.type === "novel"
            ? await Promise.all(
                chapters.map((chapter) =>
                  getPublishedSections(work.data.slug, chapter.data.chapterId),
                ),
              )
            : []
        )
          .flat()
          .map((section) =>
            sectionPath(work.data.slug, section.data.chapterId, section.data.sectionId),
          ),
      ],
    };
  }),
);
const publishedReadingPaths = workCards.flatMap((card) => card.readingPaths);
---

<BaseLayout>
  <section class="shelf shell" aria-labelledby="shelf-title">
    <h1 id="shelf-title">书架</h1>

    <a class="continue-link" data-continue-link href="#" hidden>
      继续阅读：<span data-continue-work></span> · <span data-continue-chapter></span>
    </a>

    {
      workCards.length > 0 ? (
        <div class="work-grid">
          {workCards.map((card) => <WorkCard {...card} />)}
        </div>
      ) : (
        <p class="empty-state">暂无作品。</p>
      )
    }
  </section>

  <script define:vars={{ publishedReadingPaths }}>
    const link = document.querySelector("[data-continue-link]");

    try {
      const progress = JSON.parse(localStorage.getItem("raga-progress-v1") ?? "null");
      if (progress && link && publishedReadingPaths.includes(progress.path)) {
        link.href = progress.path;
        const workName = link.querySelector("[data-continue-work]");
        const chapterName = link.querySelector("[data-continue-chapter]");
        if (workName) workName.textContent = progress.workTitle;
        if (chapterName) chapterName.textContent = progress.chapterTitle;
        link.hidden = false;
      }
    } catch {
      localStorage.removeItem("raga-progress-v1");
    }
  </script>
</BaseLayout>
