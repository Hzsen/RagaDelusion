---
import { render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import {
  getPublishedChapters,
  getPublishedWorks,
  type ChapterEntry,
} from "../../../../lib/content";
import {
  assetPath,
  chapterPath,
  workPath,
} from "../../../../lib/urls";

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  const paths = await Promise.all(
    works.map(async (work) => {
      const chapters = await getPublishedChapters(work.data.slug, work.data.type);
      return chapters.map((chapter, index) => ({
        params: {
          work: work.data.slug,
          chapter: chapter.data.chapterId,
        },
        props: {
          work,
          chapter,
          previousChapter: chapters[index - 1],
          nextChapter: chapters[index + 1],
        },
      }));
    }),
  );
  return paths.flat();
}

const { work, chapter, previousChapter, nextChapter } = Astro.props;
const isNovel = work.data.type === "novel";
const chapterTitle = `${chapter.data.chapterId} · ${chapter.data.title}`;
const shareImage = chapter.data.shareImage ?? work.data.shareImage ?? work.data.cover;
const progressRecord = {
  path: chapterPath(work.data.slug, chapter.data.chapterId),
  workSlug: work.data.slug,
  workTitle: work.data.title,
  chapterId: chapter.data.chapterId,
  chapterTitle: chapter.data.title,
};
const { Content, headings } = await render(chapter);
const subsections = chapter.data.showSubsections
  ? headings.filter((heading) => heading.depth === 2)
  : [];
---

<BaseLayout
  title={`${chapter.data.title}｜${work.data.title}`}
  description={chapter.data.summary}
  image={shareImage}
  type="article"
>
  <div class:list={["reading-shell", { "reading-shell--comic": !isNovel }]} data-reading-shell>
    <header class="chapter-header">
      <a class="back-link" href={workPath(work.data.slug)}>← {work.data.title} · 目录</a>
      <h1>{chapter.data.title}</h1>
    </header>

    {subsections.length > 0 && (
      <nav class="section-jump" aria-label="本章小节">
        <span>本章小节</span>
        <ol>
          {subsections.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    )}

    {
      isNovel ? (
        <article class="novel-body prose" data-novel-body>
          <Content />
        </article>
      ) : (
        <article class="comic-body" aria-label={chapterTitle}>
          {(chapter as Extract<ChapterEntry, { collection: "comicChapters" }>).data.pages.map(
            (page, index) => (
              <figure>
                <img
                  src={assetPath(page.src)}
                  alt={page.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                />
                <figcaption>第 {index + 1} 页</figcaption>
              </figure>
            ),
          )}
        </article>
      )
    }

    <nav class="chapter-navigation" aria-label="章节导航">
      {
        previousChapter ? (
          <a href={chapterPath(work.data.slug, previousChapter.data.chapterId)}>
            <small>上一章</small>
            <strong>{previousChapter.data.title}</strong>
          </a>
        ) : (
          <span class="chapter-navigation__empty" aria-label="没有上一章"></span>
        )
      }
      <a class="chapter-navigation__contents" href={workPath(work.data.slug)}>目录</a>
      {
        nextChapter ? (
          <a class="chapter-navigation__next" href={chapterPath(work.data.slug, nextChapter.data.chapterId)}>
            <small>下一章</small>
            <strong>{nextChapter.data.title}</strong>
          </a>
        ) : (
          <span class="chapter-navigation__empty chapter-navigation__next" aria-label="没有下一章"></span>
        )
      }
    </nav>

  </div>

  {
    isNovel && (
      <div class="reader-tools" aria-label="阅读设置">
        <button type="button" data-font-decrease aria-label="缩小字号">字−</button>
        <button type="button" data-font-increase aria-label="放大字号">字＋</button>
        <button type="button" data-reading-theme aria-label="切换明暗主题">明 / 暗</button>
      </div>
    )
  }

  <script define:vars={{ progressRecord }}>
    const PROGRESS_KEY = "raga-progress-v1";
    const SETTINGS_KEY = "raga-reader-settings-v1";
    const readerShell = document.querySelector("[data-reading-shell]");
    const fontSizes = [0.9, 1, 1.1, 1.2, 1.32, 1.45];
    let fontSizeIndex = 2;
    let saveScheduled = false;

    function saveProgress() {
      localStorage.setItem(
        PROGRESS_KEY,
        JSON.stringify({ ...progressRecord, scrollY, updatedAt: new Date().toISOString() }),
      );
      saveScheduled = false;
    }

    function scheduleSave() {
      if (!saveScheduled) {
        saveScheduled = true;
        requestAnimationFrame(saveProgress);
      }
    }

    function applyFontSize() {
      if (readerShell) {
        readerShell.style.setProperty("--reader-scale", fontSizes[fontSizeIndex]);
      }
      localStorage.setItem(SETTINGS_KEY, JSON.stringify({ fontSizeIndex }));
    }

    try {
      const settings = JSON.parse(localStorage.getItem(SETTINGS_KEY) || "null");
      if (Number.isInteger(settings?.fontSizeIndex)) {
        fontSizeIndex = Math.max(0, Math.min(fontSizes.length - 1, settings.fontSizeIndex));
        applyFontSize();
      }

      const saved = JSON.parse(localStorage.getItem(PROGRESS_KEY) || "null");
      if (!location.hash && saved?.path === progressRecord.path && saved.scrollY > 80) {
        history.scrollRestoration = "manual";
        requestAnimationFrame(() => requestAnimationFrame(() => scrollTo(0, saved.scrollY)));
      }
    } catch {
      localStorage.removeItem(PROGRESS_KEY);
      localStorage.removeItem(SETTINGS_KEY);
    }

    document.querySelector("[data-font-decrease]")?.addEventListener("click", () => {
      fontSizeIndex = Math.max(0, fontSizeIndex - 1);
      applyFontSize();
    });
    document.querySelector("[data-font-increase]")?.addEventListener("click", () => {
      fontSizeIndex = Math.min(fontSizes.length - 1, fontSizeIndex + 1);
      applyFontSize();
    });
    document.querySelector("[data-reading-theme]")?.addEventListener("click", () => {
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem("raga-theme", nextTheme);
    });

    addEventListener("scroll", scheduleSave, { passive: true });
    addEventListener("pagehide", saveProgress);
    saveProgress();
  </script>
</BaseLayout>
