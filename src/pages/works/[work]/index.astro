---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getPublishedChapters,
  getPublishedWorks,
  workStatusLabel,
  workTypeLabel,
  type WorkEntry,
} from "../../../lib/content";
import { chapterPath, sitePath } from "../../../lib/urls";

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  return works.map((work) => ({ params: { work: work.data.slug }, props: { work } }));
}

interface Props {
  work: WorkEntry;
}

const { work } = Astro.props;
const chapters = await getPublishedChapters(work.data.slug, work.data.type);
const chapterSubsections = await Promise.all(
  chapters.map(async (chapter) => {
    if (!chapter.data.showSubsections || chapter.collection !== "novelChapters") return [];
    const { headings } = await render(chapter);
    return headings.filter((heading) => heading.depth === 2);
  }),
);
---

<BaseLayout
  title={work.data.title}
  description={work.data.description}
  image={work.data.shareImage ?? work.data.cover}
>
  <div class="work-page shell">
    <a class="back-link" href={sitePath()}>← 书架</a>
    <h1>{work.data.title}</h1>
    <p class="work-meta">{workTypeLabel(work.data.type)} · {workStatusLabel(work.data.status)}</p>
    <p class="work-description">{work.data.description}</p>

    <section class="chapter-list" aria-labelledby="chapters-title">
      <h2 id="chapters-title">章节</h2>
      {
        chapters.length > 0 ? (
          <ol>
            {chapters.map((chapter, index) => (
              <li>
                <a href={chapterPath(work.data.slug, chapter.data.chapterId)}>
                  <span class="chapter-list__number">{chapter.data.chapterId}</span>
                  <span>{chapter.data.title}</span>
                  <span class="chapter-list__arrow" aria-hidden="true">›</span>
                </a>
                {chapterSubsections[index].length > 0 && (
                  <ol class="chapter-list__subsections" aria-label={`${chapter.data.title}的小节`}>
                    {chapterSubsections[index].map((heading) => (
                      <li>
                        <a href={`${chapterPath(work.data.slug, chapter.data.chapterId)}#${heading.slug}`}>
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty-state">暂无章节。</p>
        )
      }
    </section>
  </div>
</BaseLayout>
